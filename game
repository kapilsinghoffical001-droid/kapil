<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no">
<title>Bubble Shooter</title>
<style>
/* ══════════════════════════════════════════════════
   RESET & BASE
══════════════════════════════════════════════════ */
* { margin:0; padding:0; box-sizing:border-box; }
body {
  background:#0a0a1a;
  display:flex; flex-direction:column; align-items:center; justify-content:center;
  min-height:100vh; font-family:'Segoe UI',sans-serif; overflow:hidden; user-select:none;
  transition: background 2s ease;
}

/* ══════════════════════════════════════════════════
   STARFIELD
══════════════════════════════════════════════════ */
#starfield { position:fixed; inset:0; pointer-events:none; z-index:0; overflow:hidden; }
.star { position:absolute; border-radius:50%; background:#fff; animation:twinkle linear infinite; }
@keyframes twinkle { 0%,100%{opacity:.1;} 50%{opacity:.7;} }

/* ══════════════════════════════════════════════════
   GAME CONTAINER
══════════════════════════════════════════════════ */
#gameContainer { position:relative; display:flex; flex-direction:column; align-items:center; z-index:1; }

/* ── TOP BAR ── */
#topBar {
  width:100%; max-width:420px; display:flex; justify-content:space-between; align-items:center;
  padding:6px 10px; background:rgba(255,255,255,0.05); border-radius:12px;
  margin-bottom:7px; border:1px solid rgba(255,255,255,0.1);
}
.stat { text-align:center; }
.stat-label { font-size:9px; color:rgba(255,255,255,.45); text-transform:uppercase; letter-spacing:1px; }
.stat-value { font-size:18px; font-weight:700; color:#fff; transition:color .3s; }
#levelEl { font-size:18px; font-weight:800; }

/* Level badge strip */
#levelBadge {
  display:inline-flex; align-items:center; gap:4px;
  padding:2px 8px; border-radius:20px; font-size:10px; font-weight:700;
  letter-spacing:.5px; transition:background .5s, color .5s;
}

#pauseBtn {
  padding:5px 11px; background:rgba(255,255,255,.1); border:1px solid rgba(255,255,255,.2);
  border-radius:16px; color:#fff; font-size:11px; cursor:pointer; transition:background .2s; white-space:nowrap;
}
#pauseBtn:hover { background:rgba(255,255,255,.18); }

/* ── CANVAS ── */
#canvas {
  border-radius:16px; border:1px solid rgba(255,255,255,.15);
  cursor:crosshair; touch-action:none;
  box-shadow:0 0 40px rgba(100,80,255,.35); display:block;
  transition:box-shadow .5s;
}
#canvas.shake { animation:shake .3s ease; }
@keyframes shake {
  0%{transform:translate(0,0);}
  20%{transform:translate(-4px,2px);}
  40%{transform:translate(4px,-2px);}
  60%{transform:translate(-3px,3px);}
  80%{transform:translate(3px,-1px);}
  100%{transform:translate(0,0);}
}

/* ── BOTTOM BAR ── */
#bottomBar {
  width:100%; max-width:420px; display:flex; justify-content:space-between; align-items:center;
  padding:6px 10px; margin-top:7px; background:rgba(255,255,255,.05);
  border-radius:12px; border:1px solid rgba(255,255,255,.1);
}
#nextBubble { display:flex; align-items:center; gap:6px; color:rgba(255,255,255,.6); font-size:12px; }
#powerupBar { display:flex; gap:6px; }

.powerup-btn {
  padding:5px 11px; border:none; border-radius:16px; cursor:pointer;
  font-size:11px; font-weight:600; transition:transform .1s, opacity .2s; color:#fff;
}
.powerup-btn:active { transform:scale(.94); }
.powerup-btn.slow  { background:linear-gradient(135deg,#1a6fcc,#33aaff); }
.powerup-btn.multi { background:linear-gradient(135deg,#cc5500,#ff9933); }
.powerup-btn:disabled { opacity:.35; cursor:not-allowed; }
.active-power { outline:2px solid #fff; outline-offset:2px; }

/* ══════════════════════════════════════════════════
   SCREENS (shared overlay)
══════════════════════════════════════════════════ */
.screen {
  position:absolute; inset:0; border-radius:16px; z-index:10;
  display:flex; flex-direction:column; align-items:center; justify-content:flex-start;
  text-align:center; padding:20px 18px; color:#fff;
  background:rgba(6,6,22,.94); backdrop-filter:blur(8px);
  transition:opacity .35s, transform .35s; overflow-y:auto; gap:0;
}
.screen.hidden { opacity:0; pointer-events:none; transform:scale(.97); }

/* scrollbar */
.screen::-webkit-scrollbar { width:4px; }
.screen::-webkit-scrollbar-thumb { background:rgba(255,255,255,.15); border-radius:4px; }

/* ── HOME SCREEN ── */
#homeScreen { justify-content:center; }
.logo { font-size:46px; margin-bottom:2px; animation:floatLogo 3s ease-in-out infinite; }
@keyframes floatLogo { 0%,100%{transform:translateY(0);} 50%{transform:translateY(-7px);} }
#homeScreen h1 {
  font-size:26px; font-weight:800; letter-spacing:1px;
  background:linear-gradient(135deg,#a78bfa,#f472b6);
  -webkit-background-clip:text; -webkit-text-fill-color:transparent; margin-bottom:2px;
}
.tagline { font-size:11px; color:rgba(255,255,255,.38); margin-bottom:16px; letter-spacing:.4px; }

.home-stats { display:flex; gap:12px; margin-bottom:16px; }
.home-stat {
  background:rgba(255,255,255,.06); border:1px solid rgba(255,255,255,.1);
  border-radius:12px; padding:8px 14px; min-width:72px;
}
.home-stat-label { font-size:9px; color:rgba(255,255,255,.38); text-transform:uppercase; letter-spacing:1px; margin-bottom:1px; }
.home-stat-value { font-size:20px; font-weight:800; color:#fbbf24; }

/* ── MENU BUTTONS ── */
.menu-btn {
  width:210px; padding:11px 0; border:none; border-radius:26px;
  font-size:14px; font-weight:700; cursor:pointer; margin-bottom:9px;
  transition:transform .15s, box-shadow .2s, opacity .2s; letter-spacing:.3px; display:block;
}
.menu-btn:hover:not(:disabled) { transform:translateY(-2px); }
.menu-btn:active:not(:disabled) { transform:scale(.97); }
.menu-btn:disabled { opacity:.3; cursor:not-allowed; transform:none; }

.btn-primary   { background:linear-gradient(135deg,#7c3aed,#a855f7); color:#fff; box-shadow:0 4px 18px rgba(124,58,237,.5); }
.btn-primary:hover:not(:disabled) { box-shadow:0 6px 26px rgba(124,58,237,.7); }
.btn-secondary { background:linear-gradient(135deg,#1d4ed8,#3b82f6); color:#fff; box-shadow:0 4px 14px rgba(59,130,246,.4); }
.btn-secondary:hover:not(:disabled) { box-shadow:0 6px 22px rgba(59,130,246,.6); }
.btn-ghost     { background:rgba(255,255,255,.07); color:rgba(255,255,255,.75); border:1px solid rgba(255,255,255,.14); }
.btn-ghost:hover:not(:disabled) { background:rgba(255,255,255,.13); }

/* ── TOGGLES ROW ── */
.toggles-row { display:flex; gap:20px; margin-top:4px; }
.toggle-group { display:flex; align-items:center; gap:8px; }
.toggle-group span { font-size:12px; color:rgba(255,255,255,.42); }
.toggle { position:relative; width:42px; height:22px; cursor:pointer; }
.toggle input { opacity:0; width:0; height:0; }
.toggle-track { position:absolute; inset:0; border-radius:11px; background:rgba(255,255,255,.15); transition:background .25s; }
.toggle input:checked + .toggle-track { background:#7c3aed; }
.toggle-thumb { position:absolute; top:3px; left:3px; width:16px; height:16px; border-radius:50%; background:#fff; transition:transform .25s; pointer-events:none; }
.toggle input:checked ~ .toggle-thumb { transform:translateX(20px); }

.divider { width:100%; max-width:210px; height:1px; background:rgba(255,255,255,.07); margin:8px 0 12px; }

/* ── GAME OVER ── */
#gameOverScreen h2 { font-size:30px; font-weight:800; margin-bottom:4px; margin-top:8px; }
.final-score { font-size:52px; font-weight:900; color:#a78bfa; line-height:1; margin-bottom:3px; }
.best-label  { font-size:13px; color:rgba(255,255,255,.42); margin-bottom:4px; }
.go-best     { color:#fbbf24; font-weight:700; }
.go-level    { font-size:13px; color:rgba(255,255,255,.5); margin-bottom:16px; }

/* ── PAUSE ── */
#pauseScreen h2 { font-size:26px; font-weight:800; margin-bottom:4px; margin-top:8px; }
#pauseScreen .pause-sub { font-size:12px; color:rgba(255,255,255,.38); margin-bottom:20px; }

/* ── MASTER COMPLETE ── */
#masterScreen { justify-content:center; }
#masterScreen h2 { font-size:28px; font-weight:800; margin-bottom:6px; }
.master-trophy { font-size:64px; margin-bottom:8px; animation:floatLogo 2s ease-in-out infinite; }
.master-score  { font-size:48px; font-weight:900; color:#fbbf24; margin-bottom:4px; }
.master-sub    { font-size:13px; color:rgba(255,255,255,.5); margin-bottom:20px; }

/* ── LEADERBOARD ── */
.leaderboard { margin-top:12px; width:100%; max-width:255px; }
.leaderboard h3 { font-size:10px; color:rgba(255,255,255,.3); margin-bottom:7px; text-transform:uppercase; letter-spacing:1px; }
.lb-row { display:flex; justify-content:space-between; font-size:12px; padding:4px 0; border-bottom:1px solid rgba(255,255,255,.06); color:rgba(255,255,255,.55); }
.lb-row.gold   { color:#fbbf24; }
.lb-row.silver { color:#d1d5db; }
.lb-row.bronze { color:#cd7c2f; }

/* ── BADGES & ANIMATIONS ── */
.new-best-badge {
  display:inline-block; background:linear-gradient(135deg,#f59e0b,#fbbf24);
  color:#1a1000; font-size:10px; font-weight:800; padding:3px 11px;
  border-radius:18px; margin-bottom:10px; letter-spacing:.5px;
  animation:popIn .4s cubic-bezier(.175,.885,.32,1.275);
}
@keyframes popIn { from{transform:scale(0);opacity:0;} to{transform:scale(1);opacity:1;} }

/* Level-Up banner */
#levelUpBanner {
  position:absolute; top:50%; left:50%; transform:translate(-50%,-50%) scale(0);
  background:rgba(0,0,0,.75); border-radius:18px; padding:14px 32px;
  text-align:center; z-index:20; pointer-events:none;
  transition:none;
}
#levelUpBanner.show {
  animation:levelUpAnim .9s cubic-bezier(.175,.885,.32,1.275) forwards;
}
@keyframes levelUpAnim {
  0%   { transform:translate(-50%,-50%) scale(0); opacity:0; }
  30%  { transform:translate(-50%,-50%) scale(1.1); opacity:1; }
  70%  { transform:translate(-50%,-50%) scale(1); opacity:1; }
  100% { transform:translate(-50%,-50%) scale(.9); opacity:0; }
}
#levelUpBanner .lu-emoji { font-size:34px; }
#levelUpBanner .lu-title { font-size:22px; font-weight:800; color:#fff; margin:2px 0; }
#levelUpBanner .lu-sub   { font-size:13px; color:rgba(255,255,255,.6); }

/* Difficulty tier badge on home/game-over */
.tier-badge {
  display:inline-block; font-size:11px; font-weight:700; padding:3px 12px;
  border-radius:20px; margin-bottom:12px; letter-spacing:.5px;
}
.tier-easy    { background:rgba(52,211,153,.2); color:#34d399; border:1px solid rgba(52,211,153,.4); }
.tier-medium  { background:rgba(251,191,36,.2);  color:#fbbf24; border:1px solid rgba(251,191,36,.4); }
.tier-hard    { background:rgba(249,115,22,.2);  color:#f97316; border:1px solid rgba(249,115,22,.4); }
.tier-extreme { background:rgba(239,68,68,.2);   color:#f87171; border:1px solid rgba(239,68,68,.4); }

/* Progress bar */
.level-progress-wrap { width:100%; max-width:255px; margin:0 auto 10px; }
.level-progress-label { display:flex; justify-content:space-between; font-size:10px; color:rgba(255,255,255,.35); margin-bottom:4px; }
.level-progress-bar { height:4px; background:rgba(255,255,255,.1); border-radius:2px; overflow:hidden; }
.level-progress-fill { height:100%; border-radius:2px; transition:width .6s ease, background .5s; }

/* Music note floating animation */
@keyframes musicNote {
  0%   { transform:translateY(0) rotate(-10deg); opacity:.8; }
  100% { transform:translateY(-40px) rotate(10deg); opacity:0; }
}
.music-note {
  position:absolute; font-size:16px; pointer-events:none; z-index:5;
  animation:musicNote 1.2s ease-out forwards;
}
</style>
</head>
<body>

<div id="starfield"></div>

<div id="gameContainer">

  <!-- ── TOP HUD ── -->
  <div id="topBar">
    <div class="stat">
      <div class="stat-label">Score</div>
      <div class="stat-value" id="scoreEl">0</div>
    </div>
    <div class="stat">
      <div class="stat-label">Level</div>
      <div class="stat-value" id="levelEl">
