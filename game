  if (!state.gameRunning&&!state.paused) return;
  state.paused?unpauseGame():pauseGame();
};

// Power-ups
document.getElementById('slowBtn').onclick=()=>{
  if (state.slow<=0||!state.gameRunning) return;
  state.slow--;state.slowActive=true;state.slowTimer=5;updateUI();
  const btn=document.getElementById('slowBtn');btn.classList.add('active-power');
  setTimeout(()=>btn.classList.remove('active-power'),5000);
};
document.getElementById('multiBtn').onclick=()=>{
  if (state.multi<=0||!state.gameRunning) return;
  state.multi--;state.multiActive=true;updateUI();
  const btn=document.getElementById('multiBtn');btn.classList.add('active-power');
  setTimeout(()=>btn.classList.remove('active-power'),500);
};

