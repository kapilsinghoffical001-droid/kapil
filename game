//  INPUT
// ══════════════════════════════════════════════════════════════
function getPos(e) {
  const r=canvas.getBoundingClientRect();
  return e.touches?{x:e.touches[0].clientX-r.left,y:e.touches[0].clientY-r.top}:{x:e.clientX-r.left,y:e.clientY-r.top};
}
canvas.addEventListener('mousemove',  e=>{const p=getPos(e);state.aim={x:p.x,y:p.y,active:true};});
canvas.addEventListener('mouseleave', ()=>{state.aim.active=false;});
canvas.addEventListener('click',      e=>{initAudio();shoot(getPos(e).x,getPos(e).y);});
canvas.addEventListener('touchstart', e=>{e.preventDefault();initAudio();const p=getPos(e);state.aim={x:p.x,y:p.y,active:true};},{passive:false});
canvas.addEventListener('touchmove',  e=>{e.preventDefault();const p=getPos(e);state.aim={x:p.x,y:p.y,active:true};},{passive:false});
canvas.addEventListener('touchend',   e=>{e.preventDefault();if(state.aim.active)shoot(state.aim.x,state.aim.y);});

