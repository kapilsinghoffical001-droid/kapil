function updateUI() {
  document.getElementById('scoreEl').textContent  = state.score.toLocaleString();
  document.getElementById('levelNum').textContent = state.level;
  document.getElementById('comboEl').textContent  = `×${state.combo}`;
  document.getElementById('slowBtn').textContent  = `🐢 Slow (${state.slow})`;
  document.getElementById('multiBtn').textContent = `🎯 Multi (${state.multi})`;
  document.getElementById('slowBtn').disabled  = state.slow  <= 0;
  document.getElementById('multiBtn').disabled = state.multi <= 0;
  // Color level number by theme accent
  document.getElementById('levelEl').style.color = state.levelCfg.theme.accent;
}

