<script>
'use strict';
// ══════════════════════════════════════════════════════════════
//  LEVEL CONFIG ENGINE
//  Returns full difficulty config for any level 1–100
// ══════════════════════════════════════════════════════════════
const ALL_COLORS = ['#e63946','#f4a261','#2a9d8f','#457b9d','#a8dadc','#c77dff','#80b918','#f72585'];

function getLevelConfig(level) {
  const lv = Math.min(Math.max(level, 1), 100);

  // ── Tier classification ──
  let tier, tierName;
  if      (lv <= 10)  { tier = 'easy';    tierName = 'Easy'; }
  else if (lv <= 30)  { tier = 'medium';  tierName = 'Medium'; }
  else if (lv <= 60)  { tier = 'hard';    tierName = 'Hard'; }
  else                { tier = 'extreme'; tierName = 'Extreme'; }

  // ── Shoot speed (px/s): 420 at lv1 → 900 at lv100 ──
  const shootSpeed = 420 + Math.round((lv - 1) * 4.85);

  // ── Grid rows: 4 at lv1 → 14 at lv100 ──
  let rows;
  if      (lv <= 10)  rows = 4  + Math.floor((lv - 1) * 0.2);
  else if (lv <= 30)  rows = 6  + Math.floor((lv - 10) * 0.1);
  else if (lv <= 60)  rows = 8  + Math.floor((lv - 30) * 0.067);
  else                rows = 10 + Math.floor((lv - 60) * 0.1);
  rows = Math.min(rows, 14);

  // ── Number of colors ──
  let numColors;
  if      (lv <= 10) numColors = 3;
  else if (lv <= 20) numColors = 4;
  else if (lv <= 35) numColors = 5;
  else if (lv <= 55) numColors = 6;
  else               numColors = Math.min(7 + Math.floor((lv - 55) / 15), 8);

  // ── Special bubble chances ──
  const bombChance    = lv <= 10 ? 0 : lv <= 30 ? 0.03 : lv <= 60 ? 0.06 : 0.10;
  const rainbowChance = lv <= 10 ? 0 : lv <= 30 ? 0.04 : lv <= 60 ? 0.06 : 0.05;
  const iceChance     = lv <= 10 ? 0 : lv <= 30 ? 0.02 : lv <= 60 ? 0.04 : 0.07;

  // ── Shooter special chances ──
  const shootBombChance    = lv <= 10 ? 0 : lv <= 30 ? 0.04 : lv <= 60 ? 0.08 : 0.12;
  const shootRainbowChance = lv <= 10 ? 0 : lv <= 30 ? 0.05 : lv <= 60 ? 0.07 : 0.06;

  // ── Power-up starting counts (reduce at high levels) ──
  const slowUses  = lv <= 30 ? 3 : lv <= 60 ? 2 : 1;
  const multiUses = lv <= 30 ? 2 : lv <= 60 ? 2 : 1;

  // ── Background theme (changes every 10 levels) ──
  const themes = [
    { bg:'#080818', glow:'rgba(100,80,255,.35)',  accent:'#a78bfa' }, // 1-10
    { bg:'#081018', glow:'rgba(0,180,180,.3)',    accent:'#2dd4bf' }, // 11-20
    { bg:'#100818', glow:'rgba(180,50,220,.35)',  accent:'#e879f9' }, // 21-30
    { bg:'#181008', glow:'rgba(220,120,0,.3)',    accent:'#fb923c' }, // 31-40
    { bg:'#080f18', glow:'rgba(30,100,240,.35)',  accent:'#60a5fa' }, // 41-50
    { bg:'#0a1208', glow:'rgba(80,200,80,.3)',    accent:'#4ade80' }, // 51-60
    { bg:'#180808', glow:'rgba(240,50,50,.35)',   accent:'#f87171' }, // 61-70
    { bg:'#181018', glow:'rgba(220,180,0,.35)',   accent:'#facc15' }, // 71-80
    { bg:'#080818', glow:'rgba(60,200,255,.35)',  accent:'#38bdf8' }, // 81-90
    { bg:'#100010', glow:'rgba(255,60,255,.35)',  accent:'#f472b6' }, // 91-100
  ];
  const themeIdx = Math.floor((lv - 1) / 10);
  const theme = themes[Math.min(themeIdx, themes.length - 1)];

  // ── Music intensity (0 = calm, 1 = intense) ──
  const musicIntensity = (lv - 1) / 99;

  return {
    level: lv, tier, tierName, shootSpeed, rows, numColors,
    colors: ALL_COLORS.slice(0, numColors),
    bombChance, rainbowChance, iceChance,
    shootBombChance, shootRainbowChance,
    slowUses, multiUses, theme, musicIntensity,
  };
}

// ══════════════════════════════════════════════════════════════
//  CONFIG (runtime geometry — filled by resize())
// ══════════════════════════════════════════════════════════════
const CFG = { cols:11, R:18, W:0, H:0, gridOffX:0, gridOffY:0, shooterX:0, shooterY:0 };

// ══════════════════════════════════════════════════════════════
//  STATE
// ══════════════════════════════════════════════════════════════
let state = {
  bubbles:[], shooter:null, flying:[], particles:[],
  score:0, combo:1, level:1,
  gameRunning:false, paused:false,
  aim:{x:0,y:0,active:false},
  slow:3, multi:2, slowActive:false, multiActive:false, slowTimer:0,
  floatingTexts:[], iceTimers:{}, nextColor:null,
  sfxOn:true, musicOn:true,
  levelCfg: getLevelConfig(1),
};
let savedGameExists = false;

// ══════════════════════════════════════════════════════════════
//  CANVAS
// ══════════════════════════════════════════════════════════════
const canvas     = document.getElementById('canvas');
const ctx        = canvas.getContext('2d');
const nextCanvas = document.getElementById('nextCanvas');
const nextCtx    = nextCanvas.getContext('2d');

function resize() {
  const vw = Math.min(window.innerWidth - 28, 420);
  const vh = window.innerHeight - 172;
  canvas.width  = vw;
  canvas.height = Math.min(vh, 640);
  CFG.W = canvas.width; CFG.H = canvas.height;
  CFG.R    = Math.max(13, Math.floor(CFG.W / (CFG.cols * 2.1)));
  CFG.cols = Math.floor(CFG.W / (CFG.R * 2));
  recalcGrid();
}
function recalcGrid() {
  CFG.gridOffX = (CFG.W - CFG.cols * CFG.R * 2) / 2 + CFG.R;
  CFG.gridOffY = CFG.R + 4;
  CFG.shooterY = CFG.H - CFG.R - 10;
  CFG.shooterX = CFG.W / 2;
}

